# Copy to `.env.local` and fill in values. Never commit `.env.local`.

# --- Environment ---
ENV=local

# --- Identity backend ---
# `dev` is permitted ONLY when ENV=local. The API fails to boot otherwise.
IDENTITY_BACKEND=dev

# --- Adapter selection (local-first) ---
RAW_STORE=fs                # fs | gcs
INGEST_TRANSPORT=http       # http | pubsub
SECRET_BACKEND=env          # env | gsm
CONFIG_STORE=fs             # fs | gcs

# --- Local paths ---
RAW_STORE_FS_ROOT=./var/raw
CONFIG_STORE_FS_ROOT=./config

# --- Database (local vs GCP — keep these distinct) ---
# Local Docker Postgres: `make rollup-backfill`, api-dev, pollers, migrate.
LOCAL_DATABASE_URL=postgresql+psycopg://secdb:secdb@localhost:5432/secdb
# Cloud SQL: deployed API + `make cloud-rollup-backfill` (Cloud Run job secret).
# Optional: set when using Cloud SQL Auth Proxy and `make rollup-backfill-gcp`.
# GCP_DATABASE_URL=postgresql+psycopg://secdb:PASSWORD@127.0.0.1:5433/secdb
# App / Alembic default for local dev — should match LOCAL_DATABASE_URL.
DATABASE_URL=postgresql+psycopg://secdb:secdb@localhost:5432/secdb

# --- Local HTTP transport (poller -> normalizer) ---
NORMALIZER_URL=http://localhost:8001

# --- Slack DLQ alerts (Workflow trigger JSON: {"message": "..."}) ---
# Same Workflow URL as GitHub secret SLACK_DEPLOY_WEBHOOK_URL (deploy failure alerts).
# SLACK_WEBHOOK_URL=https://hooks.slack.com/triggers/...

# --- Dependabot poller (`make poller-dependabot`) ---
# Classic PAT (recommended): https://github.com/settings/tokens/new
#   Required scope:  security_events  (org-wide Dependabot alerts API)
#   Optional:        read:org         (not required by GitHub for this endpoint; harmless)
#   Do NOT rely on:   repo / public_repo alone (insufficient for private org repos)
# Fine-grained PAT: resource owner = your org; Repository access = All repositories;
#   Organization permissions → Dependabot alerts = Read
# Account role (not a scope): GitHub org Owner OR Security manager for GITHUB_ORG
# If the org uses SAML SSO: authorize the token for the org after creation
# Diagnose: ./scripts/rotate-dependabot-pat.sh --check-only
GITHUB_ORG=your-org
DEPENDABOT_PAT=ghp_xxx_replace_me

# --- SonarCloud poller (`make poller-sonarcloud`) ---
# Personal token from sonarcloud.io with read access to EVERY org listed below.
# `SONAR_ORG` (or `SONAR_ORGS`) is a comma-separated list of SonarCloud
# organisation keys to poll.
# Requires `make normalizer-dev` running so the poller can POST the snapshot.
SONAR_ORG=exampleorg
SONAR_TOKEN=your_sonar_user_token

# --- Wiz poller (`make poller-wiz`) ---
# From Wiz: user icon → User settings → Tenant (GraphQL endpoint) and
# Settings → Service Accounts (client id/secret + token URL on that page).
# WIZ_API_URL=https://api.eu26.app.wiz.io/graphql
WIZ_API_URL=
WIZ_CLIENT_ID=
WIZ_CLIENT_SECRET=
# Token URL depends on IdP (shown on the Service Accounts page):
#   Cognito (most tenants): https://auth.app.wiz.io/oauth/token
#   Auth0:                  https://auth.wiz.io/oauth/token
# WIZ_AUTH_URL=https://auth.app.wiz.io/oauth/token
# WIZ_OAUTH_AUDIENCE=wiz-api   # or beyond-api — match the Service Accounts page
# WIZ_BACKFILL_DAYS=90
# First production poll: python -m app.pollers.wiz --backfill

# --- Jira pentest poller (`make poller-jira-pentest`) ---
# Atlassian API token for a bot/service user with read access to the pentest project.
# Create at https://id.atlassian.com/manage-profile/security/api-tokens
# Requires `make normalizer-dev` running so the poller can POST the snapshot.
JIRA_BASE_URL=https://exampleorg.atlassian.net
JIRA_API_EMAIL=security-bot@example.com
JIRA_API_TOKEN=your_jira_api_token

# --- Frontend dev identity (consumed by Next.js server-side proxy) ---
# These are read by the Next.js server when forwarding requests to FastAPI in
# local dev. In production the frontend lifts the email out of the
# IAP-injected `X-Goog-Authenticated-User-Email` header and stamps the group
# list from `IAP_DEFAULT_GROUPS` instead — these vars are not consulted there.
DEV_IDENTITY_EMAIL=admin@example.com
DEV_IDENTITY_GROUPS=security@example.com

# --- Frontend backend address ---
API_BASE_URL=http://localhost:8000
# Hybrid (local Next.js + Cloud Run API via `make cloud-proxy-api`):
# API_BASE_URL=http://localhost:9080

# --- Local MCP server (`make mcp-dev`) ---
# The MCP server reuses DEV_IDENTITY_EMAIL/DEV_IDENTITY_GROUPS above to
# authenticate against the local API (mirrors the Next.js dev proxy).
# MCP_API_BASE_URL defaults to http://localhost:8000 if unset.
MCP_API_BASE_URL=http://localhost:8000
# Optional: override the X-Active-Role header sent by the MCP server.
# Valid values are `admin` and `member`. `admin` is the default and
# only matters for users who hold both roles. Legacy values (`developer`,
# `platform_eng`, `executive`) are rejected by the API.
MCP_ACTIVE_ROLE=admin

# --- Production MCP (API + frontend setup snippets) ---
# Public URL of the hosted MCP server (streamable-http). Shown on /settings/mcp.
MCP_SERVER_URL=https://mcp.your-org.example.com/mcp
